# Local development only. Replace credentials for any shared or deployed setup.
APP_NAME=AI Video Generator API
APP_VERSION=0.1.0
DEBUG=false
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_video_db

# Safe, inexpensive defaults. Real model providers are opt-in.
STORY_ANALYZER_PROVIDER=rule_based
IMAGE_PROVIDER=placeholder
VOICE_PROVIDER=placeholder
VIDEO_PROVIDER=placeholder
AUDIO_PROVIDER=placeholder

# Optional model/runtime settings. Configure only when opting into a provider.
# IMAGE_MODEL_DIR=models/image/sd15-onnx
# IMAGE_WIDTH=512
# IMAGE_HEIGHT=512
# PIPER_MODEL_PATH=models/voice/en_US-hifi_tts_92-medium/en_US-hifi_tts_92-medium.onnx
# COGVIDEOX_MODEL_PATH=
# AI_AUDIO_MODEL_PATH=models/audio/audioldm2

# Optional story-provider credentials; never put these in frontend env files.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
